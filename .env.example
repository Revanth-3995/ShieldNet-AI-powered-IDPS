# ===========================================================================
# ShieldNet Environment Configuration Example
# Copy this file to '.env' and modify values as needed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
APP_NAME=ShieldNet
APP_VERSION=3.0.0
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-a-secure-random-key

APP_HOST=0.0.0.0
APP_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=*
APP_WORKERS=1

# ---------------------------------------------------------------------------
# Database Settings
# ---------------------------------------------------------------------------
# SQLite default; swap for PostgreSQL by setting DATABASE_URL env var
# e.g., DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/shieldnet
DATABASE_URL=sqlite:///data/shieldnet.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# ---------------------------------------------------------------------------
# Logging Settings
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE_ENABLED=true
# Per-module log levels (comma-separated key=level pairs)
# e.g., LOG_MODULE_LEVELS=shieldnet.idps=DEBUG,shieldnet.steg=WARNING
LOG_MODULE_LEVELS=

# ---------------------------------------------------------------------------
# Detection Thresholds
# ---------------------------------------------------------------------------
CONF_CRITICAL=0.85
CONF_HIGH=0.70
CONF_MEDIUM=0.40

IDPS_ML_THRESHOLD=0.70
IDPS_FLOW_WINDOW_SECONDS=10
IDPS_MIN_PACKETS_FOR_ML=5

STEG_SUSPICIOUS_THRESHOLD=0.40
STEG_LIKELY_THRESHOLD=0.70
STEG_CRITICAL_THRESHOLD=0.85

CORRELATION_WINDOW_MINUTES=30

AUTO_BLOCK_ENABLED=true
AUTO_BLOCK_SEVERITIES=high,critical

# ---------------------------------------------------------------------------
# Queue & Worker Settings
# ---------------------------------------------------------------------------
ALERTBUS_MAXSIZE=1000
DETECTION_QUEUE_MAXSIZE=500
THREAD_POOL_SIZE=4
SHUTDOWN_TIMEOUT=10

# ---------------------------------------------------------------------------
# Simulation / Demo Settings
# ---------------------------------------------------------------------------
SIM_ENABLED=false
SIM_STEG_INTERVAL_MIN=4.0
SIM_STEG_INTERVAL_MAX=8.0
SIM_IDPS_INTERVAL_MIN=2.0
SIM_IDPS_INTERVAL_MAX=5.0
SIM_ATTACKER_IPS=192.168.1.47,10.0.0.99,172.16.0.5,203.0.113.42,198.51.100.7,192.168.1.22

# ---------------------------------------------------------------------------
# AI Settings
# ---------------------------------------------------------------------------
XAI_ENABLED=true
SHAP_MAX_SAMPLES=100

# ---------------------------------------------------------------------------
# Feature Toggles
# ---------------------------------------------------------------------------
FEAT_REALTIME_ALERTS=true
FEAT_AUTO_BLOCK=true
FEAT_CORRELATION=true
FEAT_HONEYPOT=true
FEAT_STEG_QUARANTINE=true
